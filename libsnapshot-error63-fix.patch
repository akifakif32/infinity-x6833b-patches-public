From c05846eba8a99c61e6596256970555801c9f6c09 Mon Sep 17 00:00:00 2001
From: akifakif32 <mhmtkfdrn@gmail.com>
Date: Sun, 27 Sep 2026 18:46:07 +0300
Subject: [PATCH] libsnapshot: fix MapAllSnapshots for recovery sideload (error
 63)

- OpenLock: create lock directory if missing (mkdir)
- ListSnapshots: treat missing snapshots dir (ENOENT) as empty list
- MapAllSnapshots: UpdateState::None is a valid clean-sideload state, return true
- Add g_debug63_info / GetDebug63Info() debug instrumentation
---
 libsnapshot/snapshot.cpp | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/libsnapshot/snapshot.cpp b/libsnapshot/snapshot.cpp
index bd5dd787..b577f9d9 100644
--- a/libsnapshot/snapshot.cpp
+++ b/libsnapshot/snapshot.cpp
@@ -1,3 +1,10 @@
+#include <cstdio>
+#include <sys/stat.h>
+#include <string>
+
+std::string g_debug63_info = "none";
+extern "C" __attribute__((visibility("default"))) const char* GetDebug63Info() { return g_debug63_info.c_str(); }
+
 // Copyright (C) 2019 The Android Open Source Project
 //
 // Licensed under the Apache License, Version 2.0 (the "License");
@@ -2958,6 +2965,9 @@ bool SnapshotManager::ListSnapshots(LockedFile* lock, std::vector<std::string>*
     auto dir_path = metadata_dir_ + "/snapshots"s;
     std::unique_ptr<DIR, decltype(&closedir)> dir(opendir(dir_path.c_str()), closedir);
     if (!dir) {
+        if (errno == ENOENT) {
+            return true;
+        }
         PLOG(ERROR) << "opendir failed: " << dir_path;
         return false;
     }
@@ -3570,21 +3580,29 @@ bool SnapshotManager::UnmapUserspaceSnapshotDevice(LockedFile* lock,
 
 bool SnapshotManager::MapAllSnapshots(const std::chrono::milliseconds& timeout_ms) {
     auto lock = LockExclusive();
-    if (!lock) return false;
+    if (!lock) {
+        g_debug63_info = "lock_exclusive_failed";
+        return false;
+    }
 
     auto state = ReadUpdateState(lock.get());
-    if (state == UpdateState::Unverified) {
+    if (state == UpdateState::None) {
+        return true;
+    } else if (state == UpdateState::Unverified) {
         if (GetCurrentSlot() == Slot::Target) {
             LOG(ERROR) << "Cannot call MapAllSnapshots when booting from the target slot.";
+            g_debug63_info = "booting_from_target_slot";
             return false;
         }
     } else if (state != UpdateState::Initiated) {
         LOG(ERROR) << "Cannot call MapAllSnapshots from update state: " << state;
+        g_debug63_info = "bad_update_state";
         return false;
     }
 
     std::vector<std::string> snapshots;
     if (!ListSnapshots(lock.get(), &snapshots, GetSnapshotSlotSuffix())) {
+        g_debug63_info = "list_snapshots_failed";
         return false;
     }
 
@@ -3596,12 +3614,14 @@ bool SnapshotManager::MapAllSnapshots(const std::chrono::milliseconds& timeout_m
     if (!metadata) {
         LOG(ERROR) << "MapAllSnapshots could not read dynamic partition metadata for device: "
                    << super_device;
+        g_debug63_info = "cannot_read_metadata";
         return false;
     }
 
     for (const auto& snapshot : snapshots) {
         if (!UnmapPartitionWithSnapshot(lock.get(), snapshot)) {
             LOG(ERROR) << "MapAllSnapshots could not unmap snapshot: " << snapshot;
+            g_debug63_info = "unmap_failed:" + snapshot;
             return false;
         }
 
@@ -3615,6 +3635,7 @@ bool SnapshotManager::MapAllSnapshots(const std::chrono::milliseconds& timeout_m
         if (!MapPartitionWithSnapshot(lock.get(), std::move(params), SnapshotContext::Mount,
                                       nullptr)) {
             LOG(ERROR) << "MapAllSnapshots failed to map: " << snapshot;
+            g_debug63_info = "map_failed:" + snapshot;
             return false;
         }
     }
@@ -3705,6 +3726,7 @@ std::string SnapshotManager::GetLockPath() const {
 
 std::unique_ptr<SnapshotManager::LockedFile> SnapshotManager::OpenLock(int lock_flags) {
     auto lock_file = GetLockPath();
+    mkdir(lock_file.c_str(), 0700);
     return OpenFile(lock_file, lock_flags);
 }
 
